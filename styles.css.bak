/* ============================================================= */
/* VARIABLES CSS                                                 */
/* ============================================================= */
:root {
    /* Colores principales */
    --verde-musgo: #2d4a3b;
    --rosa-viejo: #c9a09b;
    --beige: #f5ede4;
    --dorado: #b8963e;
    --dorado-claro: #e8d5a3;
    --blanco-roto: #faf8f5;
    --verde-salvia: #9bb5a8;
    --texto-oscuro: #2c2420;
    --texto-claro: #6b5d53;

    /* Tipografías */
    --fuente-cursiva: 'Great Vibes', cursive;
    --fuente-serif: 'Playfair Display', serif;
    --fuente-sans: 'Montserrat', sans-serif;

    /* Sombras */
    --sombra-suave: 0 8px 40px rgba(0, 0, 0, 0.06);
    --sombra-media: 0 12px 60px rgba(0, 0, 0, 0.10);

    /* Transiciones */
    --transicion: 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* ============================================================= */
/* RESET Y BASE                                                  */
/* ============================================================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--fuente-sans);
    background: var(--blanco-roto);
    color: var(--texto-oscuro);
    overflow-x: hidden;
    line-height: 1.6;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
}

/* ============================================================= */
/* BOTÓN DE MÚSICA (flotante)                                   */
/* ============================================================= */
.music-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--verde-musgo);
    color: #fff;
    border: 2px solid var(--dorado);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 1000;
    transition: var(--transicion);
    box-shadow: 0 4px 20px rgba(45, 74, 59, 0.4);
}

.music-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 30px rgba(45, 74, 59, 0.55);
}

.music-btn.playing {
    animation: pulse-music 1.2s ease-in-out infinite;
}

@keyframes pulse-music {
    0%, 100% { box-shadow: 0 4px 20px rgba(45, 74, 59, 0.4); }
    50% { box-shadow: 0 4px 35px rgba(184, 150, 62, 0.6); }
}

.music-tooltip {
    position: absolute;
    bottom: 75px;
    right: 0;
    background: rgba(0,0,0,0.75);
    color: #fff;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 300;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(8px);
    transition: var(--transicion);
    pointer-events: none;
}

.music-btn:hover .music-tooltip {
    opacity: 1;
    transform: translateY(0);
}

/* ============================================================= */
/* ============================================================= */
/* HERO - VERSIÓN DEFINITIVA (LIMPIA Y ELEGANTE)               */
/* ============================================================= */

/* === CONTENEDOR PRINCIPAL === */
.hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    overflow: hidden;
}

/* === CAPA OSCURA (MUY SUAVE) === */
.hero-overlay-light {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.30); /* Solo 30% de oscuridad */
    z-index: 1;
}

/* === CONTENEDOR DEL TEXTO === */
.hero-content-new {
    position: relative;
    z-index: 2;
    padding: 30px 40px;
    max-width: 800px;
    width: 100%;
}

/* === BADGE (texto superior) === */
.hero-badge-new {
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 8px;
    text-transform: uppercase;
    color: #f5e6b8;
    margin-bottom: 15px;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.5);
}

/* === NOMBRES === */
.hero-names-new {
    font-family: 'Great Vibes', cursive;
    font-size: 5rem;
    color: #ffffff;
    text-shadow: 
        0 2px 10px rgba(0, 0, 0, 0.4),
        0 8px 40px rgba(0, 0, 0, 0.3);
    line-height: 1.1;
    margin: 0;
    letter-spacing: 4px;
}

/* === AMPERSAND DORADO === */
.ampersand-new {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: #d4af37;
    font-size: 4rem;
    margin: 0 12px;
    text-shadow: 0 0 30px rgba(212, 175, 55, 0.2);
}

/* === DIVISOR === */
.hero-divider-new {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 20px 0;
}

.line-new {
    width: 70px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.diamond-new {
    color: #d4af37;
    font-size: 0.9rem;
}

/* ===== SEPARACIÓN ENTRE SUBTÍTULO Y SCROLL ===== */
.hero-subtitle-new {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.4rem;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
    letter-spacing: 2px;
    margin: 5px 0 30px 0; /* ← AUMENTA EL MARGEN INFERIOR */
    font-weight: 400;
}

/* ===== SCROLL ===== */
.hero-scroll-new {
    position: relative; /* ← CAMBIAR DE 'absolute' A 'relative' */
    bottom: auto;       /* ← ELIMINAR EL BOTTOM */
    left: auto;
    transform: none;
    z-index: 3;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    font-size: 0.7rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
    margin-top: 10px; /* ← ESPACIO EXTRA */
}

.hero-scroll-new:hover {
    color: #ffffff;
}

.hero-scroll-new i {
    font-size: 1.2rem;
    color: #d4af37;
    animation: bounceDown 2s ease-in-out infinite;
}

/* === ANIMACIÓN DE BOUNCE === */
@keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
}

/* ============================================================= */
/* RESPONSIVE                                                   */
/* ============================================================= */

@media (max-width: 768px) {
    .hero-names-new {
        font-size: 3.5rem;
        letter-spacing: 2px;
    }
    
    .ampersand-new {
        font-size: 2.8rem;
        margin: 0 8px;
    }
    
    .hero-badge-new {
        font-size: 0.6rem;
        letter-spacing: 5px;
    }
    
    .hero-subtitle-new {
        font-size: 1.1rem;
        letter-spacing: 1px;
    }
    
    .line-new {
        width: 45px;
    }
    
    .hero-overlay-light {
        background: rgba(0, 0, 0, 0.35);
    }
}

@media (max-width: 480px) {
    .hero-names-new {
        font-size: 2.5rem;
        letter-spacing: 1px;
    }
    
    .ampersand-new {
        font-size: 2rem;
        margin: 0 5px;
    }
    
    .hero-badge-new {
        font-size: 0.5rem;
        letter-spacing: 4px;
    }
    
    .hero-subtitle-new {
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }
    
    .line-new {
        width: 30px;
    }
    
    .hero-content-new {
        padding: 20px 15px;
    }
    
    .hero-overlay-light {
        background: rgba(0, 0, 0, 0.40);
    }
}
/* ============================================================= */
/* ============================================================= */
/* PÉTALOS FLOTANTES - VERSIÓN REALISTA                         */
/* ============================================================= */

#petals-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
}

.petal {
    position: absolute;
    top: -24px;
    opacity: 0;
    animation: petal-brisa linear infinite;
    pointer-events: none;
    will-change: transform, opacity;
}

@keyframes petal-brisa {
    0% {
        opacity: 0;
        transform: translate3d(0, -4vh, 0) rotate(-25deg) scale(0.85);
    }
    14% {
        opacity: 0.38;
    }
    32% {
        transform: translate3d(var(--sway-a), 30vh, 0) rotate(65deg) scale(1);
    }
    60% {
        transform: translate3d(var(--sway-b), 62vh, 0) rotate(185deg) scale(0.94);
    }
    84% {
        opacity: 0.3;
        transform: translate3d(var(--sway-c), 88vh, 0) rotate(285deg) scale(0.98);
    }
    100% {
        opacity: 0;
        transform: translate3d(0, 108vh, 0) rotate(360deg) scale(0.78);
    }
}

@keyframes petal-caida {
    0% {
        opacity: 0;
        transform: translate3d(0, -4vh, 0) rotate(-35deg) scale(0.82);
    }
    14% {
        opacity: 0.34;
    }
    50% {
        transform: translate3d(var(--sway-a), 52vh, 0) rotate(150deg) scale(0.96);
    }
    86% {
        opacity: 0.28;
    }
    100% {
        opacity: 0;
        transform: translate3d(var(--sway-c), 108vh, 0) rotate(330deg) scale(0.78);
    }
}

.petal--caida {
    animation-name: petal-caida;
}

/* ============================================================= */
/* SECCIÓN DETALLES                                              */
/* ============================================================= */
.section-detalles {
    padding: 80px 0;
    background: var(--blanco-roto);
    position: relative;
}

.detalles-card {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    padding: 50px 40px;
    box-shadow: var(--sombra-suave);
    border: 1px solid rgba(255,255,255,0.4);
    transition: var(--transicion);
}

.detalles-card:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-3px);
}

.detalles-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
}

.detalles-header h2 {
    font-family: var(--fuente-cursiva);
    font-size: 2.2rem;
    color: var(--verde-musgo);
    font-weight: 400;
}

.detalles-icon {
    font-size: 1.5rem;
    opacity: 0.6;
}

.detalles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 30px;
    margin-bottom: 35px;
}

.detalle-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    background: rgba(245, 237, 228, 0.4);
    transition: var(--transicion);
}

.detalle-item:hover {
    background: rgba(245, 237, 228, 0.7);
    transform: translateY(-2px);
}

.detalle-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--verde-musgo);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.detalle-info {
    display: flex;
    flex-direction: column;
}

.detalle-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--texto-claro);
    font-weight: 300;
}

.detalle-valor {
    font-family: var(--fuente-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--verde-musgo);
}

.detalle-direccion {
    font-size: 0.85rem;
    color: var(--texto-claro);
    font-weight: 300;
}

/* Botón Google Maps */
.btn-maps {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 36px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--verde-musgo), #3d5e4b);
    color: #fff;
    text-decoration: none;
    font-weight: 400;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: var(--transicion);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(45, 74, 59, 0.3);
}

.btn-maps:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 30px rgba(45, 74, 59, 0.4);
    color: #fff;
}

.btn-maps i {
    font-size: 1.1rem;
}

/* ============================================================= */
/* CUENTA REGRESIVA - VERSIÓN ELEGANTE                          */
/* ============================================================= */

.section-countdown {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--verde-musgo), #1f3528);
    color: #fff;
    position: relative;
    overflow: hidden;
}

/* Fondo decorativo */
.section-countdown::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

/* ===== HEADER ===== */
.countdown-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
}

.countdown-decorator {
    font-family: var(--fuente-serif);
    font-size: 1.8rem;
    color: var(--dorado);
    opacity: 0.6;
    letter-spacing: 4px;
}

.countdown-header h2 {
    font-family: var(--fuente-cursiva);
    font-size: 3.2rem;
    font-weight: 400;
    letter-spacing: 3px;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.2);
    margin: 0;
}

/* ===== GRID ===== */
.countdown-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 600px;
    margin: 0 auto 30px;
}

.countdown-item {
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(4px);
    padding: 20px 10px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.4s ease;
    position: relative;
}

/* Línea decorativa en cada item */
.countdown-item::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--dorado), transparent);
    opacity: 0.3;
}

.countdown-item:hover {
    background: rgba(255, 255, 255, 0.10);
    transform: translateY(-3px);
    border-color: rgba(212, 175, 55, 0.2);
}

.countdown-number {
    display: block;
    font-family: var(--fuente-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--dorado);
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
}

.countdown-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    opacity: 0.6;
    font-weight: 300;
    display: block;
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.7);
}

/* ===== MENSAJE ===== */
.countdown-mensaje {
    text-align: center;
    font-family: var(--fuente-serif);
    font-style: italic;
    font-size: 1.1rem;
    opacity: 0.6;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 1px;
    margin-top: 10px;
}

/* ============================================================= */
/* RESPONSIVE                                                    */
/* ============================================================= */

@media (max-width: 768px) {
    .countdown-header h2 {
        font-size: 2.5rem;
    }
    
    .countdown-decorator {
        font-size: 1.4rem;
    }
    
    .countdown-grid {
        gap: 14px;
        padding: 0 10px;
        max-width: 100%;
    }
    
    .countdown-number {
        font-size: 2.2rem;
    }
    
    .countdown-item {
        padding: 15px 8px;
    }
    
    .countdown-label {
        font-size: 0.6rem;
        letter-spacing: 2px;
    }
}

@media (max-width: 480px) {
    .countdown-header {
        gap: 12px;
        margin-bottom: 30px;
    }
    
    .countdown-header h2 {
        font-size: 2rem;
        letter-spacing: 2px;
    }
    
    .countdown-decorator {
        font-size: 1rem;
    }
    
    .countdown-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        padding: 0 5px;
        max-width: 100%;
    }
    
    .countdown-number {
        font-size: 1.4rem;
    }
    
    .countdown-item {
        padding: 10px 4px;
        border-radius: 10px;
    }
    
    .countdown-item::after {
        width: 20px;
        bottom: 5px;
    }
    
    .countdown-label {
        font-size: 0.5rem;
        letter-spacing: 1px;
        margin-top: 4px;
    }
    
    .countdown-mensaje {
        font-size: 0.9rem;
    }
}

@media (max-width: 360px) {
    .countdown-header h2 {
        font-size: 1.6rem;
    }
    
    .countdown-decorator {
        font-size: 0.8rem;
    }
    
    .countdown-grid {
        gap: 5px;
        padding: 0 3px;
    }
    
    .countdown-number {
        font-size: 1.1rem;
    }
    
    .countdown-item {
        padding: 8px 2px;
        border-radius: 8px;
    }
    
    .countdown-label {
        font-size: 0.4rem;
        letter-spacing: 0.5px;
    }
}
/* ============================================================= */
/* GALERÍA - IMÁGENES A TAMAÑO COMPLETO                        */
/* ============================================================= */

.section-galeria {
    padding: 60px 0 80px 0;
    background: var(--beige);
    overflow: hidden;
}

/* ===== HEADER ELEGANTE ===== */
.galeria-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
}

.galeria-decorator {
    font-family: var(--fuente-serif);
    font-size: 1.8rem;
    color: var(--dorado);
    opacity: 0.5;
    letter-spacing: 4px;
    display: inline-block;
    margin: 0 10px;
}

.galeria-header h2 {
    font-family: var(--fuente-cursiva);
    font-size: 2.8rem;
    color: var(--verde-musgo);
    font-weight: 400;
    display: inline-block;
    margin: 0 5px;
}

.galeria-sub {
    font-family: var(--fuente-serif);
    font-style: italic;
    color: var(--texto-claro);
    font-size: 1rem;
    margin-top: 10px;
    letter-spacing: 1px;
    opacity: 0.7;
}

/* ===== GRID - UNA SOLA COLUMNA ===== */
.galeria-grid {
    display: flex;
    flex-direction: column;
    gap: 30px;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ===== CADA IMAGEN OCUPA TODO EL ANCHO ===== */
.galeria-item {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    /* ELIMINAMOS aspect-ratio PARA QUE LA IMAGEN DECIDA SU TAMAÑO */
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08);
    
    /* ESTADO INICIAL: oculto y pequeño */
    opacity: 0;
    transform: scale(0.70) translateY(60px);
    transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform, opacity;
}

/* ===== LA IMAGEN SE AJUSTA AL CONTENEDOR ===== */
.galeria-item img {
    width: 100%;
    height: auto; /* ← LA ALTURA SE AJUSTA AUTOMÁTICAMENTE */
    display: block; /* ← ELIMINA ESPACIO EXTRA */
    object-fit: contain; /* ← LA IMAGEN SE MUESTRA COMPLETA */
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.galeria-item:hover img {
    transform: scale(1.03);
}

/* ===== ESTADO VISIBLE (CUANDO APARECE) ===== */
.galeria-item.visible {
    opacity: 1;
    transform: scale(1) translateY(0);
    box-shadow: 0 12px 60px rgba(0, 0, 0, 0.12);
}

/* ===== ESTADO CUANDO YA PASÓ (SE REDUCE) ===== */
.galeria-item.pasado {
    opacity: 0.35;
    transform: scale(0.85) translateY(0);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

/* ===== OVERLAY ===== */
.galeria-overlay {
    position: absolute;
    inset: 0;
    background: rgba(45, 74, 59, 0.5);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    color: #fff;
    gap: 8px;
}

.galeria-item:hover .galeria-overlay {
    opacity: 1;
}

.galeria-overlay i {
    font-size: 2.2rem;
    margin-bottom: 4px;
    color: var(--dorado);
    text-shadow: 0 0 30px rgba(212, 175, 55, 0.3);
}

.galeria-overlay span {
    font-size: 0.8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 300;
}

/* ============================================================= */
/* RESPONSIVE                                                    */
/* ============================================================= */

@media (max-width: 768px) {
    .galeria-grid {
        padding: 0 10px;
        gap: 20px;
    }
    
    .galeria-item {
        border-radius: 16px;
    }
    
    .galeria-header h2 {
        font-size: 2.2rem;
    }
    
    .galeria-decorator {
        font-size: 1.2rem;
    }
    
    .galeria-sub {
        font-size: 0.9rem;
    }
}

@media (max-width: 480px) {
    .section-galeria {
        padding: 40px 0 60px 0;
    }
    
    .galeria-grid {
        padding: 0 5px;
        gap: 15px;
        max-width: 100%;
    }
    
    .galeria-item {
        border-radius: 14px;
        /* EN MÓVILES TAMBIÉN OCUPA TODO EL ANCHO */
        width: 100%;
        min-height: 100vh; /* Ocupa toda la altura de la pantalla */
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--beige);
        /* ===================================== */
    }
    
    .galeria-item img {
        width: 100%;
        height: auto;
        object-fit: contain;
        /* ==== AQUÍ VA EL CÓDIGO DEL PASO 2 ==== */
        height: 100vh; /* Ocupa toda la altura */
        object-fit: cover; /* La imagen cubre todo */
        object-position: center;
        /* ===================================== */
    }
    
    .galeria-header {
        margin-bottom: 25px;
    }
    
    .galeria-header h2 {
        font-size: 1.8rem;
    }
    
    .galeria-decorator {
        font-size: 1rem;
    }
    
    .galeria-sub {
        font-size: 0.8rem;
    }
    
    .galeria-overlay {
        backdrop-filter: blur(2px);
    }
    
    .galeria-overlay i {
        font-size: 1.8rem;
    }
    
    .galeria-overlay span {
        font-size: 0.65rem;
        letter-spacing: 2px;
    }
}

/* ============================================================= */
/* LIGHTBOX                                                      */
/* ============================================================= */
.lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 40px;
    animation: fadeIn 0.4s ease;
}

.lightbox.active {
    display: flex;
}

.lightbox-content {
    max-width: 80%;
    max-height: 80%;
    border-radius: 12px;
    object-fit: contain;
    box-shadow: 0 20px 80px rgba(0,0,0,0.6);
}

.lightbox-close {
    position: absolute;
    top: 30px;
    right: 40px;
    color: #fff;
    font-size: 2.8rem;
    cursor: pointer;
    transition: var(--transicion);
    font-weight: 300;
}

.lightbox-close:hover {
    transform: rotate(90deg);
    color: var(--dorado);
}

.lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.6);
    font-size: 2.2rem;
    cursor: pointer;
    transition: var(--transicion);
    padding: 20px;
}

.lightbox-nav:hover {
    color: #fff;
}

.lightbox-nav.prev { left: 20px; }
.lightbox-nav.next { right: 20px; }

/* ============================================================= */
/* SECCIÓN RSVP - VERSIÓN ELEGANTE                              */
/* ============================================================= */

.section-rsvp {
    padding: 80px 0;
    background: var(--blanco-roto);
}

.rsvp-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    box-shadow: var(--sombra-suave);
    border: 1px solid rgba(255, 255, 255, 0.4);
    max-width: 650px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
}

/* ===== SEPARADOR DECORATIVO ===== */
.rsvp-decoracion {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 150px;
    height: 16px;
    margin: 0 auto 22px;
}

.rsvp-decoracion::before,
.rsvp-decoracion::after {
    position: absolute;
    top: 50%;
    width: 54px;
    height: 1px;
    background: rgba(180, 154, 99, 0.55);
    content: '';
}

.rsvp-decoracion::before { left: 0; }
.rsvp-decoracion::after { right: 0; }

.rsvp-decoracion span {
    width: 7px;
    height: 7px;
    border: 1px solid var(--dorado);
    transform: rotate(45deg);
}

.rsvp-card h2 {
    font-family: var(--fuente-cursiva);
    font-size: 2.8rem;
    color: var(--verde-musgo);
    font-weight: 400;
    margin-bottom: 12px;
}

.rsvp-text {
    color: var(--texto-claro);
    font-size: 1rem;
    margin-bottom: 30px;
    line-height: 1.8;
}

.rsvp-text strong {
    color: var(--verde-musgo);
}

/* ===== BOTÓN WHATSAPP ===== */
.btn-rsvp {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 25px rgba(37, 211, 102, 0.35);
}

.btn-rsvp:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 40px rgba(37, 211, 102, 0.5);
}

.btn-whatsapp {
    background: #25D366;
    color: #fff;
}

.btn-whatsapp i {
    font-size: 1.5rem;
}

/* ===== CÓDIGO DE VESTIMENTA ===== */
.rsvp-codigo {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 12px;
    padding-top: 25px;
    margin-top: 25px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
}

.rsvp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--texto-claro);
    font-weight: 300;
}

.rsvp-valor {
    font-family: var(--fuente-serif);
    font-style: italic;
    color: var(--verde-musgo);
    font-weight: 500;
}

/* ============================================================= */
/* RESPONSIVE                                                    */
/* ============================================================= */

@media (max-width: 768px) {
    .rsvp-card {
        padding: 35px 25px;
        margin: 0 15px;
    }
    
    .rsvp-card h2 {
        font-size: 2.2rem;
    }
    
    .btn-rsvp {
        padding: 14px 30px;
        font-size: 0.9rem;
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .rsvp-card {
        padding: 25px 18px;
        margin: 0 10px;
        border-radius: 18px;
    }
    
    .rsvp-card h2 {
        font-size: 1.8rem;
    }
    
    .rsvp-text {
        font-size: 0.9rem;
    }
    
    .btn-rsvp {
        padding: 12px 20px;
        font-size: 0.8rem;
        gap: 8px;
    }
    
    .btn-rsvp i {
        font-size: 1.2rem;
    }
    
    .rsvp-codigo {
        flex-direction: column;
        gap: 4px;
    }
}
/* ============================================================= */
/* FOOTER                                                        */
/* ============================================================= */
.footer {
    background: var(--verde-musgo);
    color: rgba(255,255,255,0.8);
    padding: 50px 0 30px;
    text-align: center;
}

.footer-ornament {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 18px;
    margin: 0 auto 18px;
}

.footer-ornament::before,
.footer-ornament::after {
    position: absolute;
    top: 50%;
    width: 54px;
    height: 1px;
    background: rgba(223, 208, 173, 0.62);
    content: '';
}

.footer-ornament::before {
    left: 0;
}

.footer-ornament::after {
    right: 0;
}

.footer-ornament span {
    width: 8px;
    height: 8px;
    border: 1px solid var(--dorado-claro);
    transform: rotate(45deg);
}

.footer-mensaje {
    font-family: var(--fuente-serif);
    font-style: italic;
    font-size: 1.2rem;
    margin-bottom: 8px;
}

.footer-copy {
    font-size: 0.8rem;
    opacity: 0.6;
    font-weight: 300;
    letter-spacing: 1px;
    margin-bottom: 20px;
}

.footer-social {
    display: flex;
    justify-content: center;
    gap: 16px;
}

.social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    transition: var(--transicion);
    text-decoration: none;
}

.social-link:hover {
    background: rgba(255,255,255,0.18);
    color: #fff;
    transform: translateY(-2px);
}

/* ============================================================= */
/* ANIMACIONES GLOBALES                                          */
/* ============================================================= */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* Glass effect */
.glass-effect {
    background: rgba(255,255,255,0.80);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.25);
}

/* Ripple effect para botones */
.btn-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
    transform: scale(0);
    animation: rippleAnim 0.6s ease-out;
    pointer-events: none;
}

@keyframes rippleAnim {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* ============================================================= */
/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .hero-content {
        padding: 30px 25px;
    }

    .hero-names {
        font-size: 3.2rem;
        letter-spacing: 4px;
    }

    .hero-names .ampersand {
        font-size: 2.6rem;
        margin: 0 8px;
    }

    .hero-badge {
        font-size: 0.65rem;
        letter-spacing: 5px;
    }

    .hero-subtitle {
        font-size: 1.15rem;
        letter-spacing: 2px;
    }

    .hero-divider .line {
        width: 50px;
    }

    .hero-overlay {
        background: linear-gradient(180deg,
            rgba(0, 0, 0, 0.35) 0%,
            rgba(45, 74, 59, 0.30) 40%,
            rgba(0, 0, 0, 0.40) 70%,
            rgba(0, 0, 0, 0.55) 100%
        );
    }
}

@media (max-width: 480px) {
    .hero-content {
        padding: 20px 15px;
    }

    .hero-names {
        font-size: 2.4rem;
        letter-spacing: 2px;
    }

    .hero-names .ampersand {
        font-size: 2.0rem;
        margin: 0 5px;
    }

    .hero-badge {
        font-size: 0.50rem;
        letter-spacing: 4px;
    }

    .hero-subtitle {
        font-size: 0.95rem;
        letter-spacing: 1px;
    }

    .hero-divider .line {
        width: 30px;
    }
}

/* ===== RESPONSIVE PARA MÓVILES ===== */
@media (max-width: 768px) {
    .hero-content {
        padding: 35px 25px;
        margin: 20px;
        backdrop-filter: blur(6px);
    }

    .hero-names {
        font-size: 2.8rem;
        letter-spacing: 2px;
        word-spacing: 4px;
    }

    .hero-names .ampersand {
        font-size: 2.2rem;
        margin: 0 6px;
    }

    .hero-badge {
        font-size: 0.60rem;
        letter-spacing: 4px;
        word-spacing: 2px;
    }

    .hero-subtitle {
        font-size: 1.0rem;
        letter-spacing: 1px;
        word-spacing: 2px;
    }

    .hero-divider .line {
        width: 40px;
    }

    .hero-overlay {
        background: linear-gradient(135deg,
            rgba(0, 0, 0, 0.45) 0%,
            rgba(45, 74, 59, 0.35) 40%,
            rgba(0, 0, 0, 0.50) 70%,
            rgba(0, 0, 0, 0.60) 100%
        );
    }
}

@media (max-width: 480px) {
    .hero-content {
        padding: 25px 18px;
        backdrop-filter: blur(4px);
    }

    .hero-names {
        font-size: 2.2rem;
        letter-spacing: 1px;
    }

    .hero-names .ampersand {
        font-size: 1.8rem;
        margin: 0 4px;
    }

    .hero-badge {
        font-size: 0.50rem;
        letter-spacing: 3px;
    }

    .hero-subtitle {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
}

/* ============================================================= */
/* RSVP - FORMULARIO EMERGENTE                                  */
/* ============================================================= */

/* ===== CONTENEDOR DEL FORMULARIO (oculto inicialmente) ===== */
.rsvp-form-container {
    margin-top: 20px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 16px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
}

.rsvp-form-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.rsvp-form-titulo {
    font-family: var(--fuente-serif);
    font-style: italic;
    color: var(--verde-musgo);
    font-size: 1rem;
    margin-bottom: 5px;
    letter-spacing: 1px;
}

/* ===== INPUTS DEL FORMULARIO ===== */
.rsvp-form-inner input {
    padding: 12px 16px;
    border: 1.5px solid #e5ddd6;
    border-radius: 12px;
    font-family: var(--fuente-sans);
    font-size: 0.95rem;
    background: #fff;
    transition: all 0.3s ease;
    outline: none;
    color: var(--texto-oscuro);
}

.rsvp-form-inner input:focus {
    border-color: var(--dorado);
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
}

.rsvp-form-inner input::placeholder {
    color: #b8a28c;
    font-weight: 300;
}

/* ===== BOTONES DEL FORMULARIO ===== */
.rsvp-form-buttons {
    display: flex;
    gap: 10px;
    margin-top: 5px;
}

.rsvp-form-buttons .btn-rsvp {
    padding: 12px 20px;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    border-radius: 12px;
    font-family: var(--fuente-sans);
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.btn-cancelar {
    background: #f0ece8;
    color: var(--texto-claro);
    box-shadow: none;
}

.btn-cancelar:hover {
    background: #e5ddd6;
    transform: translateY(-2px);
}

/* ============================================================= */
/* RESPONSIVE                                                    */
/* ============================================================= */

@media (max-width: 480px) {
    .rsvp-form-container {
        padding: 15px;
    }
    
    .rsvp-form-inner input {
        padding: 10px 14px;
        font-size: 0.85rem;
    }
    
    .rsvp-form-buttons {
        flex-direction: column;
    }
    
    .rsvp-form-buttons .btn-rsvp {
        width: 100%;
        justify-content: center;
    }
}

/* ============================================================= */
/* ACABADO EDITORIAL Y ACCESIBILIDAD                             */
/* ============================================================= */
:root {
    --verde-musgo: #30483b;
    --rosa-viejo: #b98780;
    --beige: #f1ece4;
    --dorado: #b49a63;
    --dorado-claro: #dfd0ad;
    --blanco-roto: #fbfaf7;
    --verde-salvia: #a4b1a3;
    --texto-oscuro: #292d29;
    --texto-claro: #625f57;
    --fuente-serif: 'Cormorant Garamond', Georgia, serif;
    --sombra-suave: 0 10px 32px rgba(38, 43, 37, 0.08);
    --sombra-media: 0 16px 44px rgba(38, 43, 37, 0.12);
}

body {
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
}

.hero-section {
    min-height: 100vh;
    min-height: 100svh;
    background-image: url('assets/img/foto1.jpg');
    background-size: cover;
    background-position: center 42%;
}

.hero-overlay-light {
    background: linear-gradient(180deg, rgba(20, 28, 23, 0.24), rgba(20, 28, 23, 0.46));
}

.hero-content-new {
    max-width: 860px;
    padding: 48px 40px;
}

.hero-badge-new,
.hero-scroll-new,
.detalle-label,
.countdown-label,
.galeria-overlay span,
.rsvp-label {
    letter-spacing: 0;
    font-weight: 500;
}

.hero-badge-new {
    color: #f1e4c5;
    font-size: 0.82rem;
}

.hero-names-new {
    font-size: 5.5rem;
    letter-spacing: 0;
    line-height: 1.05;
}

.ampersand-new {
    color: #d6c08d;
}

.hero-subtitle-new {
    max-width: 650px;
    margin: 12px auto 28px;
    font-size: 1.35rem;
    line-height: 1.65;
    letter-spacing: 0;
}

.hero-scroll-new {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
}

.section-detalles,
.section-countdown,
.section-galeria,
.section-rsvp {
    padding: 76px 0;
}

.detalles-card,
.rsvp-card {
    border: 1px solid rgba(48, 72, 59, 0.12);
    border-radius: 8px;
    box-shadow: var(--sombra-suave);
    backdrop-filter: none;
}

.detalles-card:hover,
.detalle-item:hover {
    transform: none;
}

.detalles-header h2,
.countdown-header h2,
.galeria-header h2,
.rsvp-card h2 {
    font-family: var(--fuente-serif);
    font-weight: 500;
    letter-spacing: 0;
}

.detalles-header h2 {
    font-size: 2.8rem;
}

.detalles-grid {
    gap: 18px;
}

.detalle-item {
    border-radius: 6px;
    background: #f4f1eb;
}

.detalle-icon {
    border-radius: 6px;
    background: var(--verde-musgo);
}

.detalle-label {
    font-size: 0.75rem;
    text-transform: uppercase;
}

.detalle-valor {
    font-size: 1.2rem;
    line-height: 1.35;
}

.btn-maps,
.btn-rsvp {
    border-radius: 4px;
    box-shadow: none;
    letter-spacing: 0;
    font-weight: 600;
}

.btn-maps {
    background: var(--verde-musgo);
}

.btn-maps:hover,
.btn-rsvp:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(38, 43, 37, 0.14);
}

.section-countdown {
    background: var(--verde-musgo);
}

.countdown-header h2 {
    font-size: 3.6rem;
}

.countdown-item {
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
}

.countdown-number {
    color: #ddc994;
    font-weight: 500;
}

.countdown-label {
    opacity: 0.82;
}

.section-galeria {
    background: #f1ece4;
}

.galeria-header h2 {
    font-size: 3rem;
}

.galeria-header {
    margin-bottom: 34px;
}

.galeria-sub {
    letter-spacing: 0;
}

.galeria-grid {
    max-width: 960px;
    gap: 22px;
}

.galeria-item {
    display: block;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: #e8e1d7;
    box-shadow: 0 8px 28px rgba(38, 43, 37, 0.1);
    cursor: zoom-in;
    opacity: 1;
    transform: none;
    transition: box-shadow 0.25s ease;
    will-change: auto;
}

.galeria-item:hover,
.galeria-item:focus-visible,
.galeria-item.visible,
.galeria-item.pasado {
    opacity: 1;
    transform: none;
    box-shadow: 0 12px 34px rgba(38, 43, 37, 0.15);
}

.galeria-item img {
    width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
}

.galeria-overlay {
    background: rgba(32, 45, 37, 0.34);
}

.galeria-overlay i {
    color: #f2e5c8;
}

.lightbox-close,
.lightbox-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    font: inherit;
}

.lightbox-close {
    width: 48px;
    height: 48px;
}

.lightbox-nav {
    width: 56px;
    height: 64px;
}

.rsvp-card {
    max-width: 680px;
}

.rsvp-card h2 {
    font-size: 3rem;
}

.rsvp-text {
    color: var(--texto-claro);
}

.btn-whatsapp {
    background: #537b60;
    color: #fff;
}

.rsvp-form-container {
    border-radius: 6px;
    box-shadow: none;
}

.rsvp-form-inner {
    text-align: left;
}

.rsvp-status {
    margin: 0;
    color: var(--verde-musgo);
    font-size: 0.9rem;
    text-align: center;
}

.rsvp-status:empty {
    display: none;
}

.rsvp-form-inner label {
    margin-bottom: -8px;
    color: var(--texto-claro);
    font-size: 0.82rem;
    font-weight: 500;
}

.rsvp-form-inner input {
    border-radius: 4px;
}

.rsvp-form-inner input:focus-visible,
button:focus-visible,
a:focus-visible {
    outline: 3px solid #b49a63;
    outline-offset: 3px;
}

.music-btn {
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    width: 50px;
    height: 50px;
    border: 1px solid #d6c08d;
    background: var(--verde-musgo);
    font-size: 1.15rem;
}

.footer {
    background: #26382e;
}

.footer-mensaje {
    font-family: var(--fuente-serif);
    font-size: 1.5rem;
}

.petal {
    z-index: 1;
}

@media (max-width: 768px) {
    .section-detalles,
    .section-countdown,
    .section-galeria,
    .section-rsvp {
        padding: 58px 0;
    }

    .hero-content-new {
        padding: 32px 24px;
    }

    .hero-badge-new {
        font-size: 0.72rem;
        line-height: 1.6;
    }

    .hero-names-new {
        font-size: 3.8rem;
    }

    .hero-subtitle-new {
        font-size: 1.12rem;
    }

    .detalles-card {
        padding: 34px 26px;
    }

    .galeria-grid {
        padding: 0 12px;
    }

    .galeria-item,
    .galeria-item.pasado {
        width: 100%;
        min-height: 0;
    }

    .galeria-item img {
        height: auto;
        max-height: 66svh;
        object-fit: contain;
    }

    .rsvp-card {
        margin: 0 12px;
    }
}

@media (max-width: 480px) {
    .hero-names-new {
        font-size: 2.8rem;
    }

    .hero-badge-new {
        font-size: 0.64rem;
        letter-spacing: 0;
    }

    .hero-subtitle-new {
        font-size: 1rem;
        line-height: 1.55;
    }

    .detalles-header h2,
    .galeria-header h2,
    .rsvp-card h2 {
        font-size: 2.35rem;
    }

    .countdown-header h2 {
        font-size: 2.4rem;
    }

    .galeria-item img {
        max-height: 62svh;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

    #petals-container {
        display: none;
    }
}